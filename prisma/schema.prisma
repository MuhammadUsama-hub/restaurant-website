// Future PostgreSQL adapter only. This frontend demo does not use a database.
// Set DATABASE_URL when intentionally introducing a PostgreSQL backend.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique
  domain        String?       @unique
  name          String
  configuration Json
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  categories    Category[]
  menuItems     MenuItem[]
  orders        Order[]
  customers     Customer[]
  reviews       Review[]
  promotions    Promotion[]
  openingHours  OpeningHour[]
}

model Category {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  slug         String
  name         String
  sortOrder    Int        @default(0)
  menuItems    MenuItem[]
  @@unique([restaurantId, slug])
  @@unique([id, restaurantId])
}

model MenuItem {
  id           String          @id @default(uuid()) @db.Uuid
  restaurantId String          @db.Uuid
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String          @db.Uuid
  category     Category        @relation(fields: [categoryId, restaurantId], references: [id, restaurantId])
  slug         String
  name         String
  description  String
  price        Decimal         @db.Decimal(10, 2)
  currency     String          @db.VarChar(3)
  portion      String?
  dietary      String[]
  allergens    String[]
  available    Boolean         @default(true)
  featured     Boolean         @default(false)
  sortOrder    Int             @default(0)
  images       MenuItemImage[]
  orderItems   OrderItem[]
  @@unique([restaurantId, slug])
  @@unique([id, restaurantId])
  @@index([restaurantId, categoryId])
}

model MenuItemImage {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @db.Uuid
  menuItemId   String   @db.Uuid
  menuItem     MenuItem @relation(fields: [menuItemId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  url          String
  alt          String
  sortOrder    Int      @default(0)
  @@index([restaurantId, menuItemId])
}

model Customer {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  email        String?
  orders       Order[]
  createdAt    DateTime   @default(now())
  @@unique([restaurantId, phone])
  @@unique([id, restaurantId])
}

model Order {
  id           String         @id @default(uuid()) @db.Uuid
  restaurantId String         @db.Uuid
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id])
  customerId   String?        @db.Uuid
  customer     Customer?      @relation(fields: [customerId, restaurantId], references: [id, restaurantId])
  provider     String
  status       OrderStatus    @default(DRAFT)
  fulfillment  Fulfillment
  customerName String
  phone        String
  address      String?
  notes        String?
  subtotal     Decimal        @db.Decimal(10, 2)
  deliveryFee  Decimal        @db.Decimal(10, 2)
  tax          Decimal        @db.Decimal(10, 2)
  total        Decimal        @db.Decimal(10, 2)
  currency     String         @db.VarChar(3)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  items        OrderItem[]
  @@unique([id, restaurantId])
  @@index([restaurantId, createdAt])
}

model OrderItem {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @db.Uuid
  orderId      String    @db.Uuid
  order        Order     @relation(fields: [orderId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  menuItemId   String?   @db.Uuid
  menuItem     MenuItem? @relation(fields: [menuItemId, restaurantId], references: [id, restaurantId])
  nameSnapshot String
  unitPrice    Decimal   @db.Decimal(10, 2)
  quantity     Int
  @@index([restaurantId, orderId])
}

model Review {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  rating       Int
  text         String
  source       String?
  verified     Boolean    @default(false)
  published    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  @@index([restaurantId, published])
}

model Promotion {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String
  price        Decimal    @db.Decimal(10, 2)
  currency     String     @db.VarChar(3)
  image        String?
  content      Json
  startsAt     DateTime?
  endsAt       DateTime?
  active       Boolean    @default(true)
  @@index([restaurantId, active])
}

model OpeningHour {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  opensAt      String?
  closesAt     String?
  closed       Boolean    @default(false)
  @@unique([restaurantId, dayOfWeek])
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum Fulfillment {
  DELIVERY
  PICKUP
}
